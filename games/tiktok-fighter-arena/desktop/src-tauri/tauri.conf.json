{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fighter Arena",
  "version": "1.0.0",
  "identifier": "com.gamehub.fighterarena",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fighter Arena",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["Italian", "English"]
      }
    }
  }
}
